# Neon Postgres connection strings (Neon console → Connection details).
# Vercel stores these as sensitive, so `vercel env pull` returns them empty.
DATABASE_URL="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (unpooled) URL — Prisma's directUrl; `npm run db:push` needs it.
# Locally it can be the same string as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: secret token used to access /worldcup/admin to enter actual results.
ADMIN_TOKEN="change-me-to-a-long-random-string"

# Key for signing player cookies. Required in production; optional locally (a
# built-in dev key is used when unset). Rotating it signs everyone out.
# SESSION_SECRET="another-long-random-string"
